# Anmeldung bei Lidl Connect
RUFNUMMER="0XXXXXXXXX"          # RUFNUMMER mit 0 am Anfang
PASSWORD="DEIN_PASSWORT"        # Passwort für die Anmeldung bei Lidl Connect

# Browserwahl: "firefox", "webkit" oder "chromium" (Standard: "firefox")
BROWSER="firefox"

# Wartezeit bei erkannter Lidl-Wartungsseite, ohne Login-/Browser-Recovery
MAINTENANCE_BACKOFF_MINUTES=15

# Wiederhergestellte Session vor ihrem ersten Ablauf einmal frisch anmelden
TOKEN_PREFLIGHT_SECONDS=300
TOKEN_PREFLIGHT_COOLDOWN_MINUTES=15

# Speicher-Recovery erst nach mehreren aufeinanderfolgenden Messungen
MEMORY_RESTART_THRESHOLD_MB=600
BROWSER_MEMORY_RESTART_THRESHOLD_MB=1400
MEMORY_RESTART_CONSECUTIVE_SAMPLES=3
MEMORY_RESTART_COOLDOWN_MINUTES=60

# Telegram-Benachrichtigungen
TELEGRAM_ALLOW=false            # Kann "true" oder "false" sein
TELEGRAM_TOKEN=""               # Token für den Telegram Bot
TELEGRAM_CHAT_ID=""             # Chat-ID für den Telegram Bot

# Discord-Benachrichtigungen
DISCORD_ALLOW=false             # Kann "true" oder "false" sein
DISCORD_WEBHOOK_URL=""          # Webhook-URL für Discord

# Existierende Browser-Prozesse beim Start killen?
# WARNUNG: Das killt ALLE Browser-Prozesse (Chrome/Firefox/etc), nicht nur von diesem Script!
# Nur aktivieren wenn du keine anderen Scripts parallel laufen hast
KILL_EXISTING_PROCESSES=false   # Kann "true" oder "false" sein

# Existierende script.js-Instanzen beim Start killen?
# Hilfreich wenn das Script mit 100% CPU im Hintergrund hängt (z.B. auf Unraid)
# Beendet nur Instanzen mit exakt demselben Lidl-Extender-Scriptpfad
KILL_SCRIPT_INSTANCES=false     # Kann "true" oder "false" sein

# Planmäßiger Browser-Neustart; 0 = deaktiviert (empfohlen, Session bleibt im Browser)
BROWSER_RESTART_INTERVAL_HOURS=0

# Auto-Update des Scripts
AUTO_UPDATE=true                # Kann "true" oder "false" sein

# Schlafmodus: "random", "fixed" oder "smart"
SLEEP_MODE="smart"
# Nur für SLEEP_MODE="fixed" (wird bei Bedarf von der sicheren Datenfrist begrenzt)
SLEEP_TIME=300

# Log-Level: "info", "warn" oder "error"
INFO_LEVEL="info"

# Sicherheitsplanung für durchgehende Downloads
# Als MAX_DOWNLOAD_MBIT die real mögliche Spitzengeschwindigkeit eintragen,
# nicht nur den vertraglichen Tarifwert.
MAX_DOWNLOAD_MBIT=55
REFILL_SAFETY_RESERVE_GB=0.20
# Wird automatisch mindestens auf die Budget-sichere Schwelle angehoben;
# bei 55 Mbit/s und 35 Checks/Stunde ergibt das derzeit ca. 0.95 GB.
REFILL_TRIGGER_GB=0.95
REFILL_EXPECTED_GB=1
SMART_EARLY_CHECK_SECONDS=5
MAX_CHECK_INTERVAL_SECONDS=900
MIN_CHECK_INTERVAL_SECONDS=5
RATE_LIMIT_REFILL_MARGIN_GB=0.005
# Ein kurz sichtbarer Vue-Platzhalter ist noch kein Rate-Limit. Erst so lange
# ohne Zahlen abwarten; es entsteht dabei kein zusätzlicher Seitenaufruf.
DATA_RENDER_TIMEOUT_SECONDS=25

# Separater Session-Reload zwischen Datenchecks (standardmäßig unnötig)
KEEPALIVE_ENABLED=false

# Speicherüberwachung: ab dieser RSS-Größe wird im Leerlauf mit bestehender
# Session ein Browser-Neustart eingeplant. 0 = nicht verwenden ist nicht
# vorgesehen, da Playwright-Kontexte über lange Laufzeiten anwachsen können.
MEMORY_RESTART_THRESHOLD_MB=600
MEMORY_RESTART_COOLDOWN_MINUTES=60

# Rolling-Window-Schutz vor dem aus dem Log abgeleiteten Lidl-Rate-Limit
RATE_LIMIT_10MIN_MAX_REQUESTS=7
RATE_LIMIT_60MIN_MAX_REQUESTS=35
RATE_LIMIT_BACKOFF_MINUTES=20
RATE_LIMIT_REPEAT_BACKOFF_MINUTES=30
